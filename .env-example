# WP integration environment variables.
# Copy this file to .env and adjust values for your local setup:
#   cp .env-example .env
# .env is gitignored — never commit it.

# SAAS API URL, used by shared utilities (public templates and template media).
VITE_SAAS_API_URL="https://daap.forcerefresh.io/api/v1"

# Logger verbosity per domain. Injected into index.html, so all five are required.
# Logger levels: All = 0, Trace = 10, Debug = 20, Info = 30, Notice = 40, Warn = 50, Error = 60, Fatal = 70, None = 100
VITE_APP_LOGGER_LEVEL_APP=0
VITE_APP_LOGGER_LEVEL_PLAYER=0
VITE_APP_LOGGER_LEVEL_OBJECT=0
VITE_APP_LOGGER_LEVEL_ANIMATION=0
VITE_APP_LOGGER_LEVEL_SDK=0
